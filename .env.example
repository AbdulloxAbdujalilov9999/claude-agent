# Anthropic API key (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=your-api-key-here
# Only needed for user-scoped keys (sk-ant-usr-...): the wrkspc_... id of the workspace to use
ANTHROPIC_WORKSPACE_ID=

# The Mina managed agent and its environment (created once; see README)
MINA_AGENT_ID=agent_...
MINA_ENVIRONMENT_ID=env_...

# Password for the web app. Pick something long; changing it signs everyone out.
MINA_PASSWORD=change-me

# Optional: spend cap per conversation, in US cents (default 200 = $2)
# MINA_SESSION_BUDGET_CENTS=200

# Optional: Postgres (Supabase session pooler URI) for push notifications that work when Mina is closed
DATABASE_URL=
# Optional: memory store id (memstore_...) Mina reads and writes across conversations
MINA_MEMORY_STORE_ID=
# Optional: OpenAI key for Mina's natural voice (falls back to the device voice)
OPENAI_API_KEY=
# Optional voice settings: MINA_TTS_VOICE (default nova), MINA_TTS_MODEL (default gpt-4o-mini-tts)
